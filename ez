#!/usr/bin/env python3

import argparse
import os
import platform
import re
import shutil
import subprocess
import sys
from collections.abc import Mapping
from pathlib import Path

RELEASE_VERSION = "v0.1.1"
CWD = Path(__file__).resolve().parent
RESOURCES_DIR = CWD / "resources"
BUILD_DIR = CWD / "build"
SYSTEM = platform.system()
NOTES_FILE = CWD / "changelog" / "notes.md"
PACKAGING_DIR = RESOURCES_DIR / "packaging"
APPIMAGE_BUILD_DIR = CWD / "dist" / "appimage"
APPIMAGE_APPDIR = APPIMAGE_BUILD_DIR / "AppDir"
APPIMAGE_PATH = CWD / "dist" / f"musiq-{platform.machine()}.AppImage"
LINUXDEPLOY_TOOL = CWD / f"linuxdeploy-{platform.machine()}.AppImage"
LINUXDEPLOY_URL = f"https://github.com/linuxdeploy/linuxdeploy/releases/download/continuous/{LINUXDEPLOY_TOOL.name}"

APPIMAGE_SYSTEM_LIBRARIES = (
    "libwebkit2gtk-4.1.so.*", "libjavascriptcoregtk-4.1.so.*",
    "libglib-2.0.so.*", "libgobject-2.0.so.*", "libgio-2.0.so.*",
    "libgmodule-2.0.so.*", "libgthread-2.0.so.*",
    "libgtk-3.so.*", "libgdk-3.so.*", "libgdk_pixbuf-2.0.so.*", "libglycin-*.so.*",
    "libpango*.so.*", "libcairo*.so.*", "libatk*.so.*", "libatspi.so.*",
    "libsoup-3.0.so.*", "libgst*.so.*", "libgudev-1.0.so.*", "libsecret-1.so.*",
    "librsvg-2.so.*", "libtinysparql-*.so.*", "libcloudproviders.so.*", "libjson-glib-1.0.so.*",
    "libenchant-2.so.*", "libmanette-0.2.so.*", "libharfbuzz-icu.so.*", "libhyphen.so.*",
)

def run(
    command: str | list[str], check: bool = True, env: Mapping[str, str] | None = None, capture: bool = False
) -> tuple[int, str]:
    display = command if isinstance(command, str) else subprocess.list2cmdline(list(command))
    print(f"exec: {display}")
    result = subprocess.run(
        command,
        shell=isinstance(command, str),
        env=env,
        capture_output=capture,
        text=capture,
        encoding="utf-8",
        cwd=CWD,
        check=SYSTEM != "Linux",
    )

    if check and result.returncode != 0:
        print(f"[ez] command failed with exit code {result.returncode}")
        sys.exit(result.returncode)

    return result.returncode, result.stdout or ""

def require_tool(name: str) -> None:
    if shutil.which(name) is not None:
        return

    print(f"[ez] required tool not found: {name}")
    sys.exit(1)

def init() -> None:
    for tool in ("git", "cmake", "ninja", "clang-format"):
        require_tool(tool)

    if not (CWD / ".gitmodules").exists():
        return

    print("[ez] initializing submodules...")
    run(["git", "submodule", "update", "--init", "--recursive"])

def configure(build_type: str) -> Path:
    build_dir = BUILD_DIR / build_type.lower()
    cache_file = build_dir / "CMakeCache.txt"
    sccache = shutil.which("sccache") or ""
    if cache_file.is_file() and (build_dir / "build.ninja").is_file():
        lines = cache_file.read_text().splitlines()
        build_matches = any(
            line.startswith("CMAKE_BUILD_TYPE:") and line.partition("=")[2] == build_type for line in lines
        )
        launcher_matches = any(
            line.startswith("CMAKE_CXX_COMPILER_LAUNCHER:") and line.partition("=")[2] == sccache for line in lines
        )
        if build_matches and launcher_matches:
            return build_dir

    cxx = os.environ.get("CXX", "clang++")
    cc = os.environ.get("CC", "clang")
    command = [
        "cmake", "-S", str(CWD), "-B", str(build_dir), "-G", "Ninja",
        f"-DCMAKE_BUILD_TYPE={build_type}",
        f"-DCMAKE_CXX_COMPILER={cxx}",
        f"-DCMAKE_C_COMPILER={cc}"
    ]

    if sccache:
        command += [
            f"-DCMAKE_C_COMPILER_LAUNCHER={sccache}",
            f"-DCMAKE_CXX_COMPILER_LAUNCHER={sccache}"
        ]

    run(command)
    return build_dir

def link_compile_commands(build_dir: Path) -> None:
    database = build_dir / "compile_commands.json"
    if not database.is_file():
        return

    link = CWD / "compile_commands.json"
    if link.is_symlink() or link.exists():
        link.unlink()
    link.symlink_to(database.relative_to(CWD))

def build(build_type: str) -> Path:
    build_dir = configure(build_type)
    link_compile_commands(build_dir)
    run(["cmake", "--build", str(build_dir), "--parallel"])
    return build_dir

def format_code() -> None:
    run("clang-format -i $(rg --files -g '*.{h,hpp,cpp,cc,cxx}' src)")

def print_release_version() -> None:
    print(RELEASE_VERSION)

def parse_release_note(version: str, dest: str) -> None:
    content = NOTES_FILE.read_text()
    regex = re.compile(r'^#+\s+(v\d+\.\d+\.\d+(?:-[0-9A-Za-z.-]+)?(?:\+[0-9A-Za-z.-]+)?)\s*$', re.MULTILINE)
    matches = list(regex.finditer(content))

    for index, match in enumerate(matches):
        if match.group(1) != version:
            continue

        note_end = matches[index + 1].start() if index + 1 < len(matches) else len(content)
        note = content[match.end():note_end].strip()

        if dest:
            Path(dest).write_text(note)
        else:
            print(note)
        return

    print(f"[ez] failed to find section({version}) in {str(NOTES_FILE)!r}")
    sys.exit(1)


def find_linuxdeploy() -> Path | None:
    configured = os.environ.get("LINUXDEPLOY")
    candidates = [
        Path(configured).expanduser() if configured else None,
        LINUXDEPLOY_TOOL,
    ]
    for candidate in candidates:
        if candidate is not None and candidate.is_file() and os.access(candidate, os.X_OK):
            return candidate.resolve()
    executable = shutil.which("linuxdeploy")
    return Path(executable).resolve() if executable else None

def package_appimage() -> None:
    if SYSTEM != "Linux":
        print("[ez] AppImage packages can only be built on Linux")
        sys.exit(1)

    linuxdeploy = find_linuxdeploy()
    if linuxdeploy is None:
        linuxdeploy = LINUXDEPLOY_TOOL
        if not linuxdeploy.exists():
            require_tool("curl")
            print("[ez] downloading linuxdeploy...")
            run([
                "curl", "-fL", "--remove-on-error", "-H", "Accept: application/octet-stream",
                LINUXDEPLOY_URL, "-o", str(linuxdeploy),
            ])
        linuxdeploy.chmod(0o755)

    build_dir = build("Release")
    if APPIMAGE_BUILD_DIR.exists():
        shutil.rmtree(APPIMAGE_BUILD_DIR)
    APPIMAGE_BUILD_DIR.mkdir(parents=True)
    run([
        "cmake", "--install", str(build_dir), "--prefix", str(APPIMAGE_APPDIR / "usr"),
        "--component", "Runtime",
    ])

    environment = os.environ.copy()
    environment["LDAI_OUTPUT"] = str(APPIMAGE_PATH)
    environment["VERSION"] = RELEASE_VERSION.removeprefix("v")
    environment.setdefault("APPIMAGE_EXTRACT_AND_RUN", "1")
    run([
        str(linuxdeploy), "--appdir", str(APPIMAGE_APPDIR),
        "--desktop-file", str(PACKAGING_DIR / "org.mezleca.musiq.desktop"),
        "--icon-file", str(RESOURCES_DIR / "icons" / "app" / "musiq.png"),
        "--icon-filename", "org.mezleca.musiq",
        "--custom-apprun", str(PACKAGING_DIR / "AppRun"),
        *[argument for library in APPIMAGE_SYSTEM_LIBRARIES for argument in ("--exclude-library", library)],
        "--output", "appimage",
    ], env=environment)
    print(f"[ez] AppImage created: {APPIMAGE_PATH}")

def main() -> None:
    parser = argparse.ArgumentParser(prog="ez")
    subparsers = parser.add_subparsers(dest="command", required=True)

    build_parser = subparsers.add_parser("build")
    build_parser.add_argument("--type", choices=("debug", "release"), default="debug")

    subparsers.add_parser("init")
    subparsers.add_parser("format")

    package_parser = subparsers.add_parser("package")
    package_parser.add_argument("--type", choices=("appimage",), default="appimage")

    run_parser = subparsers.add_parser("run")
    run_parser.add_argument("--type", choices=("debug", "release"), default="debug")

    subparsers.add_parser("release-version")

    note_parser = subparsers.add_parser("parse-note")
    note_parser.add_argument("--version", required=True)
    note_parser.add_argument("--dest", default="")

    args = parser.parse_args()

    if args.command == "init":
        init()
        return

    if args.command == "format":
        format_code()
        return

    if args.command == "package":
        package_appimage()
        return

    if args.command == "release-version":
        print_release_version()
        return

    if args.command == "parse-note":
        parse_release_note(args.version, args.dest)
        return

    build_type = args.type.capitalize()

    if args.command == "build":
        build(build_type)
    else:
        build_dir = build(build_type)
        resources_link = build_dir / "resources"
        if not resources_link.is_symlink():
            resources_link.symlink_to(RESOURCES_DIR, target_is_directory=True)
        run([str(build_dir / "musiq")])

if __name__ == "__main__":
    main()
