#!/usr/bin/env python3

import argparse
import os
import platform
import shutil
import subprocess
import sys
from collections.abc import Mapping
from pathlib import Path

CWD = Path(__file__).resolve().parent
RESOURCES_DIR = CWD / "resources"
BUILD_DIR = CWD / "build"
SYSTEM = platform.system()
PACKAGING_DIR = RESOURCES_DIR / "packaging"
APPIMAGE_BUILD_DIR = CWD / "dist" / "appimage"
APPIMAGE_APPDIR = APPIMAGE_BUILD_DIR / "AppDir"
APPIMAGE_PATH = CWD / "dist" / f"musiq-{platform.machine()}.AppImage"
LINUXDEPLOY_TOOL = CWD / f"linuxdeploy-{platform.machine()}.AppImage"
LINUXDEPLOY_URL = f"https://github.com/linuxdeploy/linuxdeploy/releases/download/continuous/{LINUXDEPLOY_TOOL.name}"

def run(
    command: str | list[str], check: bool = True, env: Mapping[str, str] | None = None, capture: bool = False
) -> tuple[int, str]:
    display = command if isinstance(command, str) else subprocess.list2cmdline(list(command))
    print(f"exec: {display}")
    result = subprocess.run(
        command,
        shell=isinstance(command, str),
        env=env,
        capture_output=capture,
        text=capture,
        encoding="utf-8",
        cwd=CWD,
        check=SYSTEM != "Linux",
    )

    if check and result.returncode != 0:
        print(f"[ez] command failed with exit code {result.returncode}")
        sys.exit(result.returncode)

    return result.returncode, result.stdout or ""

def require_tool(name: str) -> None:
    if shutil.which(name) is not None:
        return

    print(f"[ez] required tool not found: {name}")
    sys.exit(1)

def init() -> None:
    for tool in ("git", "cmake", "ninja", "clang-format"):
        require_tool(tool)

    if not (CWD / ".gitmodules").exists():
        return

    print("[ez] initializing submodules...")
    run(["git", "submodule", "update", "--init", "--recursive"])

def configure(build_type: str) -> Path:
    cache_file = BUILD_DIR / "CMakeCache.txt"
    if cache_file.is_file() and (BUILD_DIR / "build.ninja").is_file():
        for line in cache_file.read_text().splitlines():
            if line.startswith("CMAKE_BUILD_TYPE:") and line.partition("=")[2] == build_type:
                return BUILD_DIR

    command = [
        "cmake", "-S", str(CWD), "-B", str(BUILD_DIR), "-G", "Ninja",
        f"-DCMAKE_BUILD_TYPE={build_type}",
        "-DCMAKE_CXX_COMPILER=clang++",
        "-DCMAKE_C_COMPILER=clang"
    ]
    run(command)
    return BUILD_DIR

def build(build_type: str) -> Path:
    build_dir = configure(build_type)
    run(["cmake", "--build", str(build_dir), "--parallel"])
    return build_dir

def format_code() -> None:
    run("clang-format -i $(rg --files -g '*.{h,hpp,cpp,cc,cxx}' src)")

def find_linuxdeploy() -> Path | None:
    configured = os.environ.get("LINUXDEPLOY")
    candidates = [
        Path(configured).expanduser() if configured else None,
        LINUXDEPLOY_TOOL,
    ]
    for candidate in candidates:
        if candidate is not None and candidate.is_file() and os.access(candidate, os.X_OK):
            return candidate.resolve()
    executable = shutil.which("linuxdeploy")
    return Path(executable).resolve() if executable else None

def package_appimage() -> None:
    if SYSTEM != "Linux":
        print("[ez] AppImage packages can only be built on Linux")
        sys.exit(1)

    linuxdeploy = find_linuxdeploy()
    if linuxdeploy is None:
        linuxdeploy = LINUXDEPLOY_TOOL
        if not linuxdeploy.exists():
            require_tool("curl")
            print("[ez] downloading linuxdeploy...")
            run([
                "curl", "-fL", "--remove-on-error", "-H", "Accept: application/octet-stream",
                LINUXDEPLOY_URL, "-o", str(linuxdeploy),
            ])
        linuxdeploy.chmod(0o755)

    build_dir = build("Release")
    if APPIMAGE_BUILD_DIR.exists():
        shutil.rmtree(APPIMAGE_BUILD_DIR)
    APPIMAGE_BUILD_DIR.mkdir(parents=True)
    run([
        "cmake", "--install", str(build_dir), "--prefix", str(APPIMAGE_APPDIR / "usr"),
        "--component", "Runtime",
    ])

    environment = os.environ.copy()
    environment["LDAI_OUTPUT"] = str(APPIMAGE_PATH)
    environment.setdefault("APPIMAGE_EXTRACT_AND_RUN", "1")
    run([
        str(linuxdeploy), "--appdir", str(APPIMAGE_APPDIR),
        "--desktop-file", str(PACKAGING_DIR / "org.mezleca.musiq.desktop"),
        "--icon-file", str(PACKAGING_DIR / "org.mezleca.musiq.svg"),
        "--custom-apprun", str(PACKAGING_DIR / "AppRun"),
        "--exclude-library", "libwebkit2gtk-4.1.so.*",
        "--exclude-library", "libjavascriptcoregtk-4.1.so.*",
        "--output", "appimage",
    ], env=environment)
    print(f"[ez] AppImage created: {APPIMAGE_PATH}")

def main() -> None:
    parser = argparse.ArgumentParser(prog="ez")
    subparsers = parser.add_subparsers(dest="command", required=True)

    build_parser = subparsers.add_parser("build")
    build_parser.add_argument("--type", choices=("debug", "release"), default="debug")

    subparsers.add_parser("init")
    subparsers.add_parser("format")

    package_parser = subparsers.add_parser("package")
    package_parser.add_argument("--type", choices=("appimage",), default="appimage")

    run_parser = subparsers.add_parser("run")
    run_parser.add_argument("--type", choices=("debug", "release"), default="debug")

    args = parser.parse_args()

    if args.command == "init":
        init()
        return

    if args.command == "format":
        format_code()
        return

    if args.command == "package":
        package_appimage()
        return

    build_type = args.type.capitalize()

    if args.command == "build":
        build(build_type)
    else:
        build_dir = build(build_type)
        resources_link = build_dir / "resources"
        if not resources_link.is_symlink():
            resources_link.symlink_to(RESOURCES_DIR, target_is_directory=True)
        run([str(build_dir / "musiq")])

if __name__ == "__main__":
    main()
