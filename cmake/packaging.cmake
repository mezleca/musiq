if(NOT WIN32)
    return()
endif()

set(CPACK_PACKAGE_NAME "musiq")
set(CPACK_PACKAGE_VENDOR "mezleca")
set(CPACK_PACKAGE_DESCRIPTION_SUMMARY "YouTube Music client")
set(CPACK_RESOURCE_FILE_LICENSE "${PROJECT_SOURCE_DIR}/LICENSE")
set(CPACK_PACKAGE_INSTALL_DIRECTORY "musiq")
set(CPACK_PACKAGE_DIRECTORY "${PROJECT_SOURCE_DIR}/dist")
set(CPACK_VERBATIM_VARIABLES ON)

set(CPACK_PACKAGE_VERSION "${PROJECT_VERSION}")

# exclude install rules belonging to bundled dependencies
set(CPACK_INSTALL_CMAKE_PROJECTS "${PROJECT_BINARY_DIR};${PROJECT_NAME};Runtime;/")

set(CPACK_GENERATOR "INNOSETUP;ZIP")
set(CPACK_PACKAGE_EXECUTABLES "musiq;Musiq")
set(CPACK_INNOSETUP_SETUP_AppId "org.mezleca.musiq")
set(CPACK_INNOSETUP_USE_MODERN_WIZARD ON)
set(CPACK_PACKAGE_FILE_NAME "musiq-${CPACK_PACKAGE_VERSION}-${CMAKE_SYSTEM_NAME}-${CMAKE_SYSTEM_PROCESSOR}")

include(CPack)
